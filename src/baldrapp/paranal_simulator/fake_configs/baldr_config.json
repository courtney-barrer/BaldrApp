{
  "grid": {
    "telescope": "solarstein",
    "D": 1.8,
    "N": 64,
    "dim": 256
  },
  "optics": {
    "wvl0": 1.65e-06,
    "F_number": 21.2,
    "mask_diam": 1.06,
    "mask_diam_mode": "lambda_over_D",
    "theta": 1.5707963267948966,
    "theta_mode": "constant",
    "coldstop_diam": 8.4,
    "coldstop_offset": [
      0,
      0
    ]
  },
  "bandpass": {
    "wavelength_min_m": 1.5e-06,
    "wavelength_max_m": 1.8e-06,
    "n_wavelengths": 3
  },
  "source_profiles": {
    "internal": {
      "pupil": {
        "model": "SOLARSTEIN"
      },
      "spectrum": {
        "model": "blackbody",
        "temperature_K": 3000.0
      },
      "flux": {
        "photons_per_second": 1000000000.0
      }
    },
    "onsky": {
      "pupil": {
        "model": "AT"
      },
      "spectrum": {
        "model": "blackbody",
        "temperature_K": 4500.0
      },
      "flux": {
        "photons_per_second": 1000000000.0
      }
    }
  },
  "dm": {
    "dm_model": "BMC-multi-3.5",
    "actuator_coupling_factor": 0.75,
    "dm_pitch": 1.0,
    "dm_aoi": 0.0,
    "opd_per_cmd": 3e-06,
    "flat_rmse": 0.0
  },
  "fresnel_relay": {
    "enabled": true,
    "D_entrance": 0.012,
    "f_oap": 0.254,
    "f_coll": 0.04,
    "z_to_mirror": 0.5,
    "D_mirror": 0.0254,
    "edge_offset": -1.001,
    "edge_angle": 0.0,
    "f_imaging": 0.184,
    "D_coldstop": 0.002145,
    "coldstop_x_offset": 0.0,
    "coldstop_y_offset": 0.0,
    "D_detector_pupil": 0.000288,
    "pupil_misconjugation": 0.0,
    "use_nominal_pupil_conjugation": true,
    "z_mirror_to_lens": null
  },
  "detector": {
    "enabled": true,
    "binning": 4,
    "dit": 0.001,
    "ron": 0.1,
    "qe": 0.7,
    "crop_to_pixels": [
      32,
      32
    ],
    "crop_after_detection": true,
    "adu_offset": 1000.0,
    "noise_std_adu": 100.0,
    "include_shotnoise": true,
    "include_readnoise": true
  },
  "internal_aberrations": {
    "enabled": true,
    "static_opd_mode": "none",
    "dm_flat": {
      "enabled": false,
      "use_dm_flat_from_model": false
    },
    "parabolic_scratches": {
      "enabled": false,
      "list_a": [
        0.1
      ],
      "list_b": [
        0.0
      ],
      "list_c": [
        -2.0
      ],
      "width_list_dx_factor": [
        2.0
      ],
      "depth_list_m": [
        1e-07
      ]
    }
  },
  "atmosphere": {
    "enabled": true,
    "model": "von_karman",
    "r0_500nm_m": 0.126,
    "L0_m": 25.0,
    "random_seed": 2,
    "layers": [
      {
        "altitude_m": 0.0,
        "cn2_fraction": 0.7,
        "wind_speed_m_per_s": 6.0,
        "wind_direction_deg": 0.0
      },
      {
        "altitude_m": 100.0,
        "cn2_fraction": 0.1,
        "wind_speed_m_per_s": 12.0,
        "wind_direction_deg": 10.0
      },
      {
        "altitude_m": 2000.0,
        "cn2_fraction": 0.1,
        "wind_speed_m_per_s": 9.0,
        "wind_direction_deg": 120.0
      },
      {
        "altitude_m": 10000.0,
        "cn2_fraction": 0.1,
        "wind_speed_m_per_s": 20.0,
        "wind_direction_deg": 90.0
      }
    ],
    "scintillation": {
      "enabled": false
    }
  },
  "first_stage_ao": {
    "enabled": true,
    "model": "modal_removal",
    "basis": "zernike",
    "Nmodes_removed": 14,
    "apply_to": "phase",
    "lag_frames": 1,
    "correction_gain": 1.0,
    "remove_piston": true,
    "phase_scaling_factor": 1.0
  },
  "simulator_runtime": {
    "publish_opd": true,
    "active_beams": [
      1,
      2,
      3,
      4
    ],
    "nrs": 5,
    "sleep_time_s": 0.0,
    "shared_memory": {
      "cred1_global": "/dev/shm/cred1.im.shm",
      "baldr_template": "/dev/shm/baldr{beam}.im.shm",
      "dm_template": "/dev/shm/dm{beam}.im.shm",
      "split_json": "src/baldrapp/paranal_simulator/fake_configs/cred1_split.json"
    },
    "servers": {
      "camera_zmq": "tcp://127.0.0.1:6667",
      "mds_zmq": "tcp://127.0.0.1:5555"
    },
    "phasemask": {
      "default_mask": "H3",
      "properties_file": "src/baldrapp/paranal_simulator/fake_configs/phasemask_properties.json",
      "verbose": true,
      "mask_out_theta": 0.0
    },
    "time_step_s": 0.001
  }
}
